{
  "name": "custom-song-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 4747",
    "build": "next build",
    "start": "next start -p 4747",
    "typecheck": "tsc --noEmit",
    "golden": "tsx scripts/golden-run.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:e2e": "node tests/e2e/flow.e2e.cjs",
    "metrics": "tsx scripts/metrics.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "doctor": "tsx scripts/doctor.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@aws-sdk/client-s3": "^3.700.0",
    "@electric-sql/pglite": "^0.3.0",
