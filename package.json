    "@opentelemetry/exporter-logs-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@posthog/ai": "^8.20.0",
    "@sentry/nextjs": "11.12.0",
    "@stripe/stripe-js": "10.1.0",
    "drizzle-orm": "^0.44.0",
    "next": "^15.5.0",
    "postgres": "^3.4.5",
    "posthog-js": "^1.447.15",
    "posthog-node": "^5.71.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stripe": "23.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
