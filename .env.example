# Copy to .env. Every provider runs in a free mock mode when its keys are empty.

# ---- App ----
# Public base URL (Kie.ai calls back here). Local dev works without a tunnel: the app polls Kie.ai.
APP_URL=http://localhost:4747
# Signs preview and download links. REQUIRED in production; use a long random string.
MEDIA_SIGNING_SECRET=

# ---- Claude (brief, lyrics, verifier) ----
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Fast model for the dig-deeper follow-up questions inside the story quiz.
PROBE_MODEL=claude-haiku-5-5
MOCK_LLM=
# Server-side refusal fallback (beta). On by default.
LLM_REFUSAL_FALLBACK=true
# Cost ESTIMATES for reporting only ($ per million tokens).
LLM_INPUT_COST_PER_MTOK=4
LLM_OUTPUT_COST_PER_MTOK=20

# ---- Songcraft ----
# v3 (default, idea-first writer), v2 or v1 (earlier writers, for A/B tests)
SONGCRAFT_WRITER=v3
# First drafts per song, written in parallel; the best one is kept (1 or 2)
LYRIC_DRAFTS=2
# Automatic lyric repair passes (0-2). Shortening and craft passes share this budget.
LYRIC_MAX_REPAIRS=1
# Run a craft-only repair when the weighted creative score (1-10) is below this. 0 disables.
LYRIC_CRAFT_REPAIR_BELOW=5
# Also polish when the singability score is below this (bad stress garbles the sung vocal). 0 disables.
LYRIC_POLISH_SINGABILITY_BELOW=7
BRIEF_FACT_CAP=12
# At most this many must-use (priority-1) facts; extras become priority 2
BRIEF_MAX_PRIORITY1=3
# Experiments: legacy style string / generic vocal words
DIRECTION_MODE=director
VOCAL_MODE=specific

# ---- Kie.ai (Suno) ----
KIE_API_KEY=
KIE_MODEL=V6
KIE_ALLOWED_MODELS=V6,V6_MINI,V6_WILD
MOCK_KIE=
# Signs our callback URLs (per generation). REQUIRED in production: a long random string
# (`npm run doctor -- --fix` makes one). The server refuses to start without it.
KIE_WEBHOOK_SECRET=
# Kie.ai webhookHmacKey from kie.ai/settings. When set, callbacks must carry a valid X-Webhook-Signature.
# REQUIRED in production whenever KIE_API_KEY is set.
KIE_WEBHOOK_HMAC_KEY=
# Optional comma-separated allowlist of audio download hosts.
KIE_AUDIO_HOSTS=
MOCK_KIE_DELAY_MS=6000

# ---- Versions per customer, and the generation budget ----
DESIRED_CANDIDATES=3
MIN_CANDIDATES=1
MAX_AUTO_TASKS=3
MAX_TASKS_PER_PROJECT=5
MAX_EST_SPEND_USD=0.75
# ESTIMATED Kie cost of one task (returns ~2 tracks). Check your Kie.ai dashboard for actual credits.
# Measured: one song (2 tasks + lyric timing) used 26 credits; 12 credits = $0.06 per task
KIE_TASK_COST_USD=0.065
EXPECTED_TRACKS_PER_TASK=2
TASK_TIMEOUT_MS=900000
# distinct = each task a different style; same_style = signature only
VARIANT_MODE=distinct
# collect = keep every usable track; per_task = best track per task (one task per version)
CANDIDATE_COLLECTION=collect
RANDOMIZE_CANDIDATE_ORDER=true

# ---- Preview and quality ----
PREVIEW_SECONDS=45
PREVIEW_URL_TTL_SEC=3600
DOWNLOAD_URL_TTL_SEC=900
MIN_LYRIC_COVERAGE=0.6

# ---- Payments: Stripe Checkout Sessions in our own page (card, Link, Apple Pay, Google Pay) ----
# The Stripe switch. false (default) = test checkout button, nothing is charged, even with keys
# below, so the quiz and song generation can be tested freely. true = real payments (needs the keys).
STRIPE_ENABLED=false
# Empty keys = test checkout button (no real payments).
# Production: prefer a restricted key (rk_live_...) with write access to Checkout Sessions
# and read access to PaymentIntents, Tax settings, Tax registrations and Tax calculations.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# whsec_... from the webhook endpoint https://<your-domain>/api/webhooks/stripe
# events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed, payment_intent.payment_failed, charge.refunded,
#         product.updated, price.created, price.updated, price.deleted (price changes show at once)
# Locally: `stripe listen --forward-to localhost:4747/api/webhooks/stripe` prints one.
STRIPE_WEBHOOK_SECRET=
# Stripe Tax. Turn on only after Dashboard -> Tax has a head office address AND an active
# registration for each place you collect in; with no registration Stripe silently collects $0.
# `npm run doctor` checks both and runs a test calculation.
STRIPE_AUTOMATIC_TAX=false
# Digital Audio Works - downloaded - non subscription - with permanent rights. Confirm with your tax advisor.
# List: https://docs.stripe.com/tax/tax-codes
STRIPE_TAX_CODE=txcd_10401100
# exclusive = tax added on top of the price (usual in the US); inclusive = price already includes tax
STRIPE_TAX_BEHAVIOR=exclusive
# Price in the smallest currency unit (3900 = $39.00) when it isn't read from Stripe (below). The browser never sends a price.
SONG_PRICE_CENTS=3900
# Where the price comes from. Recommended: STRIPE_PRODUCT_ID (prod_...): the site shows and sells that
# product's DEFAULT price, so you change the price in Stripe (add a price, "Set as default price") with no
# deploy. Or STRIPE_PRICE_ID (price_...) to pin one price. Neither: SONG_PRICE_CENTS above.
# With either, SONG_PRICE_CENTS is only the fallback shown if Stripe can't be reached at startup.
# Sandbox and live mode have different ids. The product's tax code applies.
STRIPE_PRODUCT_ID=
STRIPE_PRICE_ID=
SONG_CURRENCY=usd
# Stripe's fee, for the margin estimates in /admin/numbers only (US cards: 2.9% + 30c)
STRIPE_FEE_PERCENT=2.9
STRIPE_FEE_FIXED_CENTS=30
MOCK_PAYMENTS=

# ---- Database / storage ----
# Postgres URL (Supabase, Railway). Empty = embedded PGlite in ./data
DATABASE_URL=
# Audio files. local = disk (./storage or STORAGE_LOCAL_DIR). s3 = Cloudflare R2 or any S3:
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com  S3_REGION=auto
#   Use an R2 API token with Object Read & Write on this bucket only. Keep the bucket private.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Admin ----
# /admin (songs, takes, feedback, Numbers) is behind a Supabase Auth sign-in (an emailed link by default).
# Only the emails in ADMIN_EMAILS get in. Locally, with these empty, /admin is open; in
# production, with these empty, /admin is closed to everyone. Setup steps: README -> Admin sign-in.
SUPABASE_URL=
# Supabase -> Project Settings -> API Keys: the publishable key (sb_publishable_...) or the legacy anon key
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated accounts allowed into /admin
ADMIN_EMAILS=
# email (default: Supabase emails a one-time sign-in link), or google / github once enabled in Supabase
ADMIN_AUTH_PROVIDER=email
# Opens the admin API only (GET /api/admin/ip with an x-admin-token header).
ADMIN_TOKEN=

# ---- Live test site ----
# true = while Stripe is off (STRIPE_ENABLED=false), the checkout step unlocks songs for free.
# Needed on a live server; locally the test button works either way.
FREE_DOWNLOADS=false
# The "How did it land?" tester box on the song page. Empty = only while payments are in test mode.
TESTER_FEEDBACK=
# Optional site-wide cap on new songs per 24 hours (0 = no cap, the default)
MAX_SONGS_PER_DAY=0
# Sentry warning when new songs in 24 hours reach this, and each multiple of it (0 = off)
SONG_VOLUME_ALERT_PER_DAY=100
# Free songs (previews) one email address may start per rolling 7 days (0 = no limit).
# Lower case, +tags and Gmail dots are ignored when comparing addresses.
MAX_SONGS_PER_EMAIL_PER_WEEK=3

# ---- Preview links ----
# The direct link to a song's versions (/r/<id>?p=...) works on any device for this many hours
# after the versions are ready. The browser that made the song keeps access after that.
PREVIEW_LINK_HOURS=48
# Days after the versions are ready before audio nobody bought is deleted. Paid songs are kept.
PREVIEW_RETENTION_DAYS=14

# ---- Abuse and spend control ----
# Cloudflare Turnstile bot check on "Write the song" (dash.cloudflare.com > Turnstile > Add site).
# On only when BOTH are set; production refuses to start with just one.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Header our host's proxy sets to the visitor's IP. Default: x-real-ip on Railway; elsewhere
# the last X-Forwarded-For entry. Never trust a header the visitor can set.
CLIENT_IP_HEADER=
# Lyric rewrites (new lyrics or hand edits) per song, ever; and the estimated Claude $ per song
# after which rewrites stop. Both are counted in the database.
MAX_LYRIC_REWRITES=6
MAX_LLM_USD_PER_SONG=5
# Site-wide in-quiz follow-up questions per 24 hours (past it, a free rule-based version answers).
MAX_PROBES_PER_DAY=3000

# ---- Email (the preview link when versions are ready; the permanent song link after purchase) ----
# One provider: Postmark (POSTMARK_SERVER_TOKEN) or Resend (RESEND_API_KEY), plus the sender.
# Off until set. Add the provider's SPF and DKIM records to your domain first, and a DMARC record.
POSTMARK_SERVER_TOKEN=
RESEND_API_KEY=
# e.g. Cryworthy <songs@yourdomain.com> (a domain you verified with the provider)
EMAIL_FROM=
# Where customers write for help. Shown in the footer, the legal pages and the purchase email.
SUPPORT_EMAIL=
# The company customers buy from, as it appears in the footer and the terms (e.g. Cryworthy LLC).
LEGAL_ENTITY_NAME=

# ---- Error tracking ----
# Sentry DSN (sentry.io > Project settings > Client Keys). Used by the server and the browser;
# a DSN is public by design. Empty = off. Reports never include story text, emails, cookies,
# request bodies, query strings, delivery links or media tokens.
NEXT_PUBLIC_SENTRY_DSN=

# ---- Front end ----
# Placeholder brand name shown in the quiz and on the song page.
NEXT_PUBLIC_BRAND_NAME=
# Optional wait-page video (mp4/webm URL). Empty shows the built-in studio card.
NEXT_PUBLIC_WAIT_VIDEO_URL=
# Average seconds from "recording" to "versions ready"; drives the wait progress bar.
NEXT_PUBLIC_EST_RECORD_SECONDS=180

# ---- Analytics: PostHog (funnels, quiz drop-off, session replay) ----
# Project API key (phc_...) from PostHog -> Settings -> Project. Public by design. Empty = off.
# Set it BEFORE building: it is baked into the browser code (the Dockerfile takes it as a build arg).
NEXT_PUBLIC_POSTHOG_KEY=
# https://us.i.posthog.com (US cloud, default) or https://eu.i.posthog.com (EU cloud)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
