# ---- Public base URL (needed so Kie.ai can call back) ----
# Local dev without a tunnel works too: the app polls Kie.ai when no callback arrives.
APP_URL=http://localhost:4747

# ---- Claude (lyrics, brief extraction, verifier) ----
# Leave empty to run in MOCK_LLM mode (deterministic fake lyrics, no API cost).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Fast model for the dig-deeper follow-ups inside the quiz.
PROBE_MODEL=claude-haiku-5-5
MOCK_LLM=

# ---- Kie.ai (Suno) ----
# Leave empty to run in MOCK_KIE mode (ffmpeg-generated test tones, no API cost).
KIE_API_KEY=
KIE_MODEL=V6
MOCK_KIE=
# Shared secret appended to the callback URL so random POSTs are rejected.
KIE_WEBHOOK_SECRET=change-me

# ---- Database ----
# Postgres connection string (Supabase etc). Leave empty to use embedded PGlite in ./data.
DATABASE_URL=

# ---- Storage ----
# "local" writes to ./storage and serves via /api/audio. "s3" uses S3/R2 below.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ---- Quality gate ----
PREVIEW_SECONDS=45
MIN_LYRIC_COVERAGE=0.6
MAX_GENERATION_ATTEMPTS=2

# ---- Front end ----
# Placeholder brand name shown in the quiz and song page.
NEXT_PUBLIC_BRAND_NAME=
# Optional wait-page video (mp4/webm URL). Empty shows the built-in studio card.
NEXT_PUBLIC_WAIT_VIDEO_URL=
# Average seconds from "recording" to "preview ready"; drives the wait progress bar.
NEXT_PUBLIC_EST_RECORD_SECONDS=180
# Code that unlocks the full song without checkout, for creators filming reactions. Empty disables it.
CREATOR_UNLOCK_CODE=
